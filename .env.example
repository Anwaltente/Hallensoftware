# Vorlage: als ".env" kopieren und eigene Werte eintragen. Die echte .env nie weitergeben oder committen.

# --- Datenbank in der Cloud (Turso) -------------------------------------------
# Ohne diese beiden Zeilen nutzt die App wie bisher die lokale Datei data/halle.db.
# TURSO_DATABASE_URL=libsql://halle-db-xxxx.aws-eu-west-1.turso.io
# TURSO_AUTH_TOKEN=dein-turso-token
# optional: Lese-Spiegel alle n Sekunden komplett erneuern (Standard 15)
# HALLE_TURSO_SYNC_S=15

# --- KI-Serienmaße (Radstand, Spurweite, Reifenbreite) via Google Gemini --------
GEMINI_API_KEY=dein-schluessel-hier
# optional, Standard: gemini-3.8-flash
# GEMINI_MODEL=gemini-3.8-flash
